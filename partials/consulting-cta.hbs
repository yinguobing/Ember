{{!-- 文末咨询 CTA 区块。
     ⚠️ 2026-09-19：本区块改为**由主题设置驱动**，主题文件本身不含任何站点专属内容。
     背景：此前这里的自我介绍、二维码、外链都是硬编码的，任何人克隆本主题都会把原作者的
     个人身份挂到自己站上（实测有站点整站搬运），既尴尬也不可维护。
     现在是「空默认」：未在 Design → Theme settings 填 consulting_text 的站点，整块不渲染。
     字段（见 package.json 的 config.custom）：consulting_title / consulting_text /
     consulting_qr / consulting_url。 --}}
{{#if @custom.consulting_text}}
<section class="gh-consulting-cta gh-canvas">
    <hr class="gh-consulting-cta-divider">
    {{#if @custom.consulting_title}}
        <h3 class="gh-consulting-cta-title">{{@custom.consulting_title}}</h3>
    {{/if}}
    <p class="gh-consulting-cta-desc">{{@custom.consulting_text}}</p>
    <div class="gh-consulting-cta-actions">
        {{#if @custom.consulting_qr}}
            <span class="gh-consulting-qr">
                <span class="gh-consulting-cta-btn gh-consulting-cta-btn-primary" role="button" tabindex="0">
                    {{> "icons/wechat"}}
                    {{t "微信聊聊"}}
                </span>
                <img src="{{@custom.consulting_qr}}" alt="{{t "微信二维码"}}" class="gh-consulting-qr-img" loading="lazy">
            </span>
        {{/if}}
        {{#if @custom.consulting_url}}
            <a href="{{@custom.consulting_url}}" class="gh-consulting-cta-btn">{{t "看我能做什么"}}</a>
        {{/if}}
    </div>
</section>
<script>
(function () {
    var qr = document.querySelector(".gh-consulting-cta .gh-consulting-qr");
    if (!qr) { return; }
    var btn = qr.querySelector(".gh-consulting-cta-btn-primary");
    if (!btn) { return; }
    btn.addEventListener("click", function (e) {
        e.preventDefault();
        var isOpen = qr.classList.toggle("is-open");
        document.body.classList.toggle("qr-open", isOpen);
    });
    document.addEventListener("click", function (e) {
        if (!qr.contains(e.target)) {
            qr.classList.remove("is-open");
            document.body.classList.remove("qr-open");
        }
    });
})();
</script>
{{/if}}
